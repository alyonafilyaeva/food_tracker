DATABASE_URL="postgresql://food_tracker:food_tracker@localhost:5432/food_tracker?schema=public"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
PORT=4000
# Разрешить ли регистрацию новых пользователей через POST /api/auth/register.
# После создания своего аккаунта рекомендуется выставить false.
ALLOW_REGISTRATION=true
# В проде — адрес фронтенда для CORS, напр. https://food-tracker.vercel.app. Локально можно не задавать.
# FRONTEND_URL=
